
PORT=3000


# Cấu trúc: postgresql://<tài khoản>:<mật khẩu>@<máy>:<cổng>/<tên CSDL>?schema=public
DATABASE_URL="postgresql://fashion:your_password@localhost:5433/fashion_db?schema=public"

# Chuỗi kết nối Redis
REDIS_URL="redis://localhost:6379"
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT: chuỗi bí mật dài ít nhất 32 ký tự, mỗi máy (phát triển / máy chủ) dùng một chuỗi khác nhau
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Gửi email qua Gmail: SMTP_USER là địa chỉ Gmail, SMTP_PASS là App Password 16 ký tự.
# Để trống hai dòng này khi phát triển: mã OTP sẽ được in ra terminal thay vì gửi email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fashion Market <your_email@gmail.com>"
