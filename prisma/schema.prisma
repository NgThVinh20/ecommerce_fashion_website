
//  yarn prisma migrate dev --name <tên thay đổi>

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

// Trạng thái tài khoản
enum UserStatus {
  ACTIVE
  LOCKED
}

// Bảng users
model User {
  id_user       Int        @id @default(autoincrement()) // PK, tự tăng
  fullname      String     @db.VarChar(100)              // Họ tên
  email         String     @unique @db.VarChar(255)      // Email đăng nhập, không trùng
  email_verified Boolean   @default(false)               // Đã xác thực email bằng OTP chưa
  phone_number  String?    @db.VarChar(15)               // Số điện thoại (có thể trống)
  hash_password String     @db.VarChar(255)              // Mật khẩu đã băm bằng bcrypt
  role          UserRole   @default(CUSTOMER)            // Mặc định là khách hàng
  status        UserStatus @default(ACTIVE)              // Mặc định đang hoạt động
  created_at    DateTime   @default(now())               // Thời điểm tạo
  updated_at    DateTime   @updatedAt                    // Tự cập nhật khi sửa
  shop          Shop?
  @@map("users") // Tên bảng thật trong PostgreSQL
}

// trạng thái shop
enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
  LOCKED
}
// bảng shops
model Shop {
  id_shop           Int        @id @default(autoincrement())
  id_user           Int        @unique
  shop_name         String     @unique @db.VarChar(100)
  description       String?    @db.Text
  address           String     @db.VarChar(255)
  phone_number      String     @db.VarChar(15)
  status            ShopStatus @default(PENDING)
  pending_balance   Decimal    @default(0) @db.Decimal(15, 0)
  available_balance Decimal    @default(0) @db.Decimal(15, 0)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  slug              String     @unique @db.VarChar(120)
  tax_code            String?   @db.VarChar(14)  
  bank_name           String?   @db.VarChar(100) 
  bank_account_number String?   @db.VarChar(20)  
  bank_account_name   String?   @db.VarChar(100) 
  bank_updated_at     DateTime?                  
  reject_reason       String?   @db.Text
  lock_reason         String?   @db.Text         // lý do admin khóa shop
  name_updated_at     DateTime?    
  user User @relation(fields: [id_user], references: [id_user])
  products Product[]

  @@map("shops")
}
// bảng categories
model Category {
  id_category          Int      @id @default(autoincrement())
  category_name        String   @db.VarChar(100)
  id_categories_parent Int?
  level                Int      @db.SmallInt
  commission_rate      Decimal  @default(0) @db.Decimal(5, 2)
  created_at           DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [id_categories_parent], references: [id_category], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([id_categories_parent, category_name])
  @@map("categories")
}

// trạng thái sản phẩm
enum ProductStatus {
  ACTIVE   // đang bán
  HIDDEN   // người bán tự ẩn
  BANNED   // admin cấm vì vi phạm (người bán không tự hiện lại được)
  DELETED  // người bán xóa (xóa mềm, đơn hàng cũ vẫn tham chiếu được)
}

// bảng products
model Product {
  id_product     Int           @id @default(autoincrement())
  id_shop        Int
  id_category    Int                                   // loại mặt hàng cấp cuối
  product_name   String        @db.VarChar(200)
  search_name    String        @db.VarChar(200)        // tên không dấu, chữ thường để tìm kiếm
  description    String?       @db.Text
  attributes     Json?                                 // thuộc tính chung: { "Chất liệu": "Cotton", ... }
  images         String[]                              // URL ảnh Cloudinary, ảnh đầu là ảnh bìa
  status         ProductStatus @default(ACTIVE)
  ban_reason     String?       @db.Text                // lý do admin cấm
  min_price      Decimal?      @db.Decimal(15, 0)      // giá thấp nhất trong các SKU đang bán
  max_price      Decimal?      @db.Decimal(15, 0)      // giá cao nhất trong các SKU đang bán
  sold_count     Int           @default(0)             // lượt bán (cộng khi đơn giao thành công)
  is_featured    Boolean       @default(false)         // sản phẩm nổi bật của shop
  featured_order Int?                                  // thứ tự hiển thị trong khối nổi bật
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  shop     Shop     @relation(fields: [id_shop], references: [id_shop], onDelete: Restrict)
  category Category @relation(fields: [id_category], references: [id_category], onDelete: Restrict)
  skus     Sku[]

  @@index([id_shop, status])
  @@index([id_category, status])
  @@index([status, created_at])
  @@index([sold_count])
  @@map("products")
}

// bảng skus: biến thể theo size và màu
model Sku {
  id_sku     Int      @id @default(autoincrement())
  id_product Int
  sku_code   String   @db.VarChar(50)                  // mã do người bán đặt, không trùng trong cùng shop
  size       String   @db.VarChar(20)
  color      String   @db.VarChar(50)
  price      Decimal  @db.Decimal(15, 0)               // CHECK > 0 (thêm trong migration)
  stock      Int      @default(0)                      // tồn kho, CHECK >= 0 (thêm trong migration)
  image_url  String?  @db.VarChar(500)                 // ảnh riêng theo màu
  is_active  Boolean  @default(true)                   // false = ngừng bán biến thể này
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [id_product], references: [id_product], onDelete: Restrict)

  @@unique([id_product, size, color])
  @@map("skus")
}

