// =============================================================
// Lược đồ cơ sở dữ liệu (Prisma). Mỗi "model" là một bảng.
// Sửa xong chạy: yarn prisma migrate dev --name <tên thay đổi>
// =============================================================

// Sinh thư viện Prisma Client để dùng trong code TypeScript
generator client {
  provider = "prisma-client-js"
}

// Kết nối PostgreSQL, chuỗi kết nối lấy từ DATABASE_URL trong file .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Vai trò người dùng: khách hàng, nhà cung cấp, quản trị viên
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

// Trạng thái tài khoản: đang hoạt động hoặc bị khóa
enum UserStatus {
  ACTIVE
  LOCKED
}

// Bảng users: người dùng của hệ thống
model User {
  id_user       Int        @id @default(autoincrement()) // PK, tự tăng
  fullname      String     @db.VarChar(100)              // Họ tên
  email         String     @unique @db.VarChar(255)      // Email đăng nhập, không trùng
  phone_number  String?    @db.VarChar(15)               // Số điện thoại (có thể trống)
  hash_password String     @db.VarChar(255)              // Mật khẩu đã băm bằng bcrypt
  role          UserRole   @default(CUSTOMER)            // Mặc định là khách hàng
  status        UserStatus @default(ACTIVE)              // Mặc định đang hoạt động
  created_at    DateTime   @default(now())               // Thời điểm tạo
  updated_at    DateTime   @updatedAt                    // Tự cập nhật khi sửa

  @@map("users") // Tên bảng thật trong PostgreSQL
}
