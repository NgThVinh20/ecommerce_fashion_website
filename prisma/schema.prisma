
//  yarn prisma migrate dev --name <tên thay đổi>

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

// Trạng thái tài khoản
enum UserStatus {
  ACTIVE
  LOCKED
}

// Bảng users
model User {
  id_user       Int        @id @default(autoincrement()) // PK, tự tăng
  fullname      String     @db.VarChar(100)              // Họ tên
  email         String     @unique @db.VarChar(255)      // Email đăng nhập, không trùng
  email_verified Boolean   @default(false)               // Đã xác thực email bằng OTP chưa
  phone_number  String?    @db.VarChar(15)               // Số điện thoại (có thể trống)
  hash_password String     @db.VarChar(255)              // Mật khẩu đã băm bằng bcrypt
  role          UserRole   @default(CUSTOMER)            // Mặc định là khách hàng
  status        UserStatus @default(ACTIVE)              // Mặc định đang hoạt động
  created_at    DateTime   @default(now())               // Thời điểm tạo
  updated_at    DateTime   @updatedAt                    // Tự cập nhật khi sửa
  shop          Shop?
  @@map("users") // Tên bảng thật trong PostgreSQL
}

// trạng thái shop
enum ShopStatus {
  PENDING
  ACTIVE
  REJECTED
  LOCKED
}
// bảng shops
model Shop {
  id_shop           Int        @id @default(autoincrement())
  id_user           Int        @unique
  shop_name         String     @unique @db.VarChar(100)
  description       String?    @db.Text
  address           String     @db.VarChar(255)
  phone_number      String     @db.VarChar(15)
  status            ShopStatus @default(PENDING)
  pending_balance   Decimal    @default(0) @db.Decimal(15, 0)
  available_balance Decimal    @default(0) @db.Decimal(15, 0)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  slug              String     @unique @db.VarChar(120)
  user User @relation(fields: [id_user], references: [id_user])
  
  @@map("shops")
}
// bảng categories
model Category {
  id_category          Int      @id @default(autoincrement())
  category_name        String   @db.VarChar(100)
  id_categories_parent Int?
  level                Int      @db.SmallInt
  commission_rate      Decimal  @default(0) @db.Decimal(5, 2)
  created_at           DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [id_categories_parent], references: [id_category], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  @@unique([id_categories_parent, category_name])
  @@map("categories")
}